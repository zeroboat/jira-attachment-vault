# Only what the server needs before it starts. Jira connection, sync intervals, dry run, etc.
# are set on the Settings page in the web UI. See "Configuration" in README.md for optional vars.

# Folder where attachment copies are stored (the vault itself, not a system backup)
VAULT_DIR=/mnt/vault-disk/jira-attachments

# Pick your own random values, e.g. openssl rand -hex 32
POSTGRES_PASSWORD=
# Signs login sessions and encrypts the Jira API token saved in the DB. Don't change it later,
# or the saved token can't be decrypted (you'd re-enter it in Settings).
SECRET_KEY=
# First login password. Change it on the Settings page afterwards.
ADMIN_PASSWORD=

# Timezone for container logs (docker compose logs). Optional, default UTC.
# Times in the web UI and Jira comments follow the Settings page timezone instead.
# TZ=Asia/Seoul

# ---------- Storage (optional; default is plain files in VAULT_DIR) ----------
# Changing these needs a container restart. Don't switch backends after backing up
# without migrating first (see "Switching" in README.md).
# STORAGE_BACKEND=local                 # local | seaweedfs | s3

# --- SeaweedFS: STORAGE_BACKEND=seaweedfs ---
# COMPOSE_PROFILES=seaweedfs            # plain `docker compose up -d` also starts SeaweedFS
# SEAWEEDFS_SSD_DIR=/mnt/ssd/seaweedfs  # master/filer metadata
# SEAWEEDFS_HDD_DIR=/mnt/hdd/seaweedfs  # file content
# SEAWEEDFS_TAG=latest                  # pin a version in production
# SEAWEEDFS_REPLICATION=000             # 000 = no replication
# SEAWEEDFS_VOLUME_SIZE_MB=30000
# S3_ACCESS_KEY=                        # any random values; SeaweedFS account is created from them
# S3_SECRET_KEY=

# --- Other S3-compatible store: STORAGE_BACKEND=s3 ---
# S3_ENDPOINT_URL=                      # empty = AWS
# S3_BUCKET=jira-attachments
# S3_PREFIX=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
