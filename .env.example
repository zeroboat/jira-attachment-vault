# Only what the server needs before it starts. Jira connection, sync intervals, dry run, etc.
# are set on the Settings page in the web UI. See "Configuration" in README.md for optional vars.

# Folder where attachment copies are stored (the vault itself, not a system backup)
VAULT_DIR=/mnt/vault-disk/jira-attachments

# Pick your own random values, e.g. openssl rand -hex 32
POSTGRES_PASSWORD=
# Signs login sessions and encrypts the Jira API token saved in the DB. Don't change it later,
# or the saved token can't be decrypted (you'd re-enter it in Settings).
SECRET_KEY=
# First login password. Change it on the Settings page afterwards.
ADMIN_PASSWORD=
